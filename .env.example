# Local development defaults only — never put real credentials here.
# Copy to `.env` (git-ignored): cp .env.example .env

# Docker Compose (PostgreSQL container)
POSTGRES_USER=orders
POSTGRES_PASSWORD=orders
POSTGRES_DB=orders

# Application
DATABASE_URL=postgresql+psycopg://orders:orders@127.0.0.1:5432/orders
CELERY_BROKER_URL=redis://127.0.0.1:6379/0

# Outbound ERP integration
ERP_BASE_URL=http://127.0.0.1:8001
ERP_HTTP_TIMEOUT_SECONDS=2.0
ERP_MAX_ATTEMPTS=3

# Mock ERP failure injection (development only)
# One of: normal, http_503, http_429, http_400, timeout_before_create, timeout_after_create
MOCK_ERP_FAILURE_MODE=normal
# Must exceed ERP_HTTP_TIMEOUT_SECONDS to trigger a client-side timeout
MOCK_ERP_TIMEOUT_DELAY_SECONDS=5.0
